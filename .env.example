# Copy this file to .env and fill in your Box app credentials.
# Never commit .env to version control.

BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret
BOX_ENTERPRISE_ID=your_enterprise_id

# ID of the NDA file uploaded to Box (from the file URL).
NDA_FILE_ID=your_file_id

# ID of the folder where the summary is written (from the folder URL).
OUTPUT_FOLDER_ID=your_folder_id
